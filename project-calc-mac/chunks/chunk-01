function fillV1(){const i=parseInt($('l1variant').value)-1;if(i<0)return;const v=V1[i];$('l1x').value=v[0];$('l1y').value=v[1];$('l1c3').value=v[2];autoRanges1()}
function autoRanges1(){const rz=n('l1rzPreset',.7891),c3=n('l1c3',.09);const max=Math.max(.01,rz-c3);$('l1c1max').value=(max-.01).toFixed(3);$('l1c2max').value=(max-.01).toFixed(3)}
function serviceCoeff(c1,c2,c3,x,y,stepDeg){const N=Math.max(36,Math.round(360/stepDeg));let ok=0;for(let i=0;i<N;i++){const p=-PI+2*PI*i/N,bx=x-c3*Math.cos(p),by=y-c3*Math.sin(p),r=Math.hypot(bx,by);if(r<=c1+c2+1e-12 && r+1e-12>=Math.abs(c1-c2))ok++}return ok/N}
function calc1(){
 const rz=n('l1rzPreset'),x=n('l1x'),y=n('l1y'),c3=n('l1c3'),ps=n('l1phiStep',1),a0=n('l1c1min'),a1=n('l1c1max'),da=n('l1c1step'),b0=n('l1c2min'),b1=n('l1c2max'),db=n('l1c2step');
 if([rz,x,y,c3,ps,a0,a1,da,b0,b1,db].some(v=>!Number.isFinite(v))||da<=0||db<=0||ps<=0){return resultCard('Ошибка ввода','Проверьте числовые поля.','<div class="note warning">Шаги должны быть положительными.</div>','Ошибка ввода')}
 const pts=[];let best=null,feasible=0;const maxI=160000;let iter=0;
 for(let c1=a0;c1<=a1+da/3;c1+=da){for(let c2=b0;c2<=b1+db/3;c2+=db){if(++iter>maxI)break;if(c1<=0||c2<=0||c1+c2+c3>rz+1e-12)continue;const theta=serviceCoeff(c1,c2,c3,x,y,ps);const p={c1,c2,theta};pts.push(p);feasible++;if(!best||theta>best.theta+1e-12||(Math.abs(theta-best.theta)<1e-12&&c1+c2<best.c1+best.c2))best=p}if(iter>maxI)break}
 if(!best)return resultCard('Допустимые решения не найдены','Проверьте радиус зоны и диапазоны C₁, C₂.','<div class="note warning">Условие C₁+C₂+C₃ ≤ Rз не выполнилось ни для одной пары.</div>','Лабораторная 1: допустимые решения не найдены');
 pts.sort((p,q)=>q.theta-p.theta||(p.c1+p.c2)-(q.c1+q.c2));const top=pts.slice(0,10);const dist=Math.hypot(x,y);const warning=c3>=rz?'<div class="note warning">C₃ ≥ Rз. Это значение выглядит как опечатка таблицы; результат формально рассчитан только для заданных ограничений.</div>':'';
 const body=`${warning}<div class="metric-grid">${metric('Оптимальное C₁',fmt(best.c1,4),'м')}${metric('Оптимальное C₂',fmt(best.c2,4),'м')}${metric('Коэффициент сервиса θ',fmt(best.theta,5),`${fmt(best.theta*100,2)} % ориентаций`,'ok')}${metric('Запас радиуса',fmt(rz-best.c1-best.c2-c3,5),'м')}</div>
 <div class="table-wrap"><table><thead><tr><th>#</th><th>C₁, м</th><th>C₂, м</th><th>C₁+C₂+C₃</th><th>θ</th></tr></thead><tbody>${top.map((p,i)=>`<tr><td>${i+1}</td><td>${fmt(p.c1,4)}</td><td>${fmt(p.c2,4)}</td><td>${fmt(p.c1+p.c2+c3,4)}</td><td>${fmt(p.theta,5)}</td></tr>`).join('')}</tbody></table></div><canvas id="chart1" width="900" height="420"></canvas>`;
 const text=`Лабораторная №1 — геометрический синтез\nRз=${rz} м; A=(${x}; ${y}) м; C3=${c3} м\nОптимум: C1=${best.c1} м; C2=${best.c2} м; θ=${best.theta} (${best.theta*100} %)\nПроверено допустимых пар: ${feasible}; OA=${dist} м.`;
 resultCard('Оптимум найден',`Проверено ${feasible} допустимых пар C₁, C₂.`,body,text);requestAnimationFrame(()=>drawScatter('chart1',pts,'C₁, м','C₂, м',p=>p.theta));
}

// LAB 2
function render2(){const inputs=`<div class="fields">${variantSelect('l2variant',24,'fillV2()')}${field('l2epsx','ε_A^x',.001,'м')}${field('l2epsy','ε_A^y',.003,'м')}${field('l2epsn','ε_A^n',.01,'рад')}${field('l2l1','l₁',.5,'м')}${field('l2l2','l₂',.4,'м')}${field('l2l3','l₃',.3,'м')}${field('l2q1','q₁',0,'рад')}${field('l2q2','q₂',.4,'рад')}${field('l2q3','q₃',-.4,'рад')}${field('l2d1','d₁',4,'ден. ед.')}${field('l2d2','d₂',2,'ден. ед.')}${field('l2d3','d₃',1,'ден. ед.')}</div><div class="actions"><button class="btn primary" onclick="calc2()">Решить задачу ЛП</button></div><details><summary>Математическая постановка</summary><div class="formula">max S = S₁/d₁ + S₂/d₂ + S₃/d₃</div><p>Ограничения строятся по абсолютным значениям производных координат схвата по q₁, q₂, q₃ и по сумме S₁+S₂+S₃.</p></details>`;$('content').innerHTML=shell(inputs,'Углы — в радианах. Решение находится перебором всех вершин многогранника допустимых погрешностей.');}
function fillV2(){const i=parseInt($('l2variant').value)-1;if(i<0)return;const v=V2[i],ids=['l2l1','l2l2','l2l3','l2q1','l2q2','l2q3','l2d1','l2d2','l2d3'];ids.forEach((id,j)=>$(id).value=v[j])}
function solve3(A,b){const M=A.map((r,i)=>[...r,b[i]]);for(let c=0;c<3;c++){let p=c;for(let r=c+1;r<3;r++)if(Math.abs(M[r][c])>Math.abs(M[p][c]))p=r;if(Math.abs(M[p][c])<1e-13)return null;[M[c],M[p]]=[M[p],M[c]];const z=M[c][c];for(let j=c;j<4;j++)M[c][j]/=z;for(let r=0;r<3;r++)if(r!==c){const f=M[r][c];for(let j=c;j<4;j++)M[r][j]-=f*M[c][j]}}return M.map(r=>r[3])}
function calc2(){
 const l1=n('l2l1'),l2=n('l2l2'),l3=n('l2l3'),q1=n('l2q1'),q2=n('l2q2'),q3=n('l2q3'),d=[n('l2d1'),n('l2d2'),n('l2d3')],eps=[n('l2epsx'),n('l2epsy'),n('l2epsn')];
 if([l1,l2,l3,q1,q2,q3,...d,...eps].some(v=>!Number.isFinite(v))||d.some(v=>v<=0)||eps.some(v=>v<=0))return resultCard('Ошибка ввода','Все длины, погрешности и коэффициенты должны быть корректны.','','Ошибка ввода');
 const q12=q1+q2,q123=q12+q3;
 const dx=[-l1*Math.sin(q1)-l2*Math.sin(q12)-l3*Math.sin(q123),-l2*Math.sin(q12)-l3*Math.sin(q123),-l3*Math.sin(q123)];
 const dy=[l1*Math.cos(q1)+l2*Math.cos(q12)+l3*Math.cos(q123),l2*Math.cos(q12)+l3*Math.cos(q123),l3*Math.cos(q123)];
 const x=l1*Math.cos(q1)+l2*Math.cos(q12)+l3*Math.cos(q123),y=l1*Math.sin(q1)+l2*Math.sin(q12)+l3*Math.sin(q123);
 const cons=[{a:dx.map(Math.abs),b:eps[0],name:'εx'},{a:dy.map(Math.abs),b:eps[1],name:'εy'},{a:[1,1,1],b:eps[2],name:'εn'},{a:[-1,0,0],b:0,name:'S1=0'},{a:[0,-1,0],b:0,name:'S2=0'},{a:[0,0,-1],b:0,name:'S3=0'}];
 let best=null;const vertices=[];for(const comb of combinations(cons,3)){const s=solve3(comb.map(c=>c.a),comb.map(c=>c.b));if(!s)continue;if(cons.every(c=>c.a.reduce((z,v,i)=>z+v*s[i],0)<=c.b+1e-9)){const obj=s[0]/d[0]+s[1]/d[1]+s[2]/d[2];const v={s,obj,active:comb.map(c=>c.name)};vertices.push(v);if(!best||obj>best.obj)best=v}}
 if(!best)return resultCard('Решение не найдено','Допустимая область пуста.','','Лабораторная 2: решение не найдено');
 const [s1,s2,s3]=best.s, ex=dx.map(Math.abs).reduce((z,v,i)=>z+v*best.s[i],0),ey=dy.map(Math.abs).reduce((z,v,i)=>z+v*best.s[i],0),en=s1+s2+s3;
 const body=`<div class="metric-grid">${metric('S₁',sci(s1),'рад')}${metric('S₂',sci(s2),'рад')}${metric('S₃',sci(s3),'рад')}${metric('Критерий S',fmt(best.obj,8),'максимум','ok')}</div>
 <div class="table-wrap"><table><thead><tr><th>Проверка</th><th>Получено</th><th>Допустимо</th><th>Запас</th></tr></thead><tbody><tr><td>Погрешность X</td><td>${sci(ex)}</td><td>${sci(eps[0])}</td><td>${sci(eps[0]-ex)}</td></tr><tr><td>Погрешность Y</td><td>${sci(ey)}</td><td>${sci(eps[1])}</td><td>${sci(eps[1]-ey)}</td></tr><tr><td>Ориентация</td><td>${sci(en)}</td><td>${sci(eps[2])}</td><td>${sci(eps[2]-en)}</td></tr></tbody></table></div>
 <details open><summary>Промежуточные данные</summary><p>Координаты схвата: x=${fmt(x,6)} м, y=${fmt(y,6)} м.</p><div class="formula">|∂x/∂q| = [${dx.map(v=>fmt(Math.abs(v),6)).join('; ')}]</div><div class="formula">|∂y/∂q| = [${dy.map(v=>fmt(Math.abs(v),6)).join('; ')}]</div><p>Активные ограничения: ${best.active.join(', ')}. Найдено допустимых вершин: ${vertices.length}.</p></details>`;
 const text=`Лабораторная №2 — точностной синтез\nS1=${s1}; S2=${s2}; S3=${s3} рад\nКритерий S=${best.obj}\nεx=${ex} ≤ ${eps[0]}; εy=${ey} ≤ ${eps[1]}; εn=${en} ≤ ${eps[2]}\nАктивные ограничения: ${best.active.join(', ')}`;
 resultCard('Оптимальное распределение погрешностей','Линейная задача решена по вершинам допустимой области.',body,text);
}

