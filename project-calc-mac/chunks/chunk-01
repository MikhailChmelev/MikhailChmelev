function render3(){const inputs=`<div class="fields">${variantSelect('l3variant',25,'fillV3()')}${selectField('l3mat','Материал',[[1,'Сталь'],[2,'Дюралюминий'],[3,'Ручные E и ρ']])}${field('l3l','Длина l',1,'м')}${field('l3phi','Угол φ',0,'рад')}${field('l3fext','Fвн',1,'Н')}${field('l3mext','Mвн',3,'Н·м')}${field('l3E','Модуль E',2.1e11,'Па')}${field('l3rho','Плотность ρ',7800,'кг/м³')}${field('l3kd','Kд',.023,'кг/(Н·м)')}${field('l3kp','Kр',.008,'кг/(Н·м)')}${field('l3sp','sр',4e5,'1/рад')}${field('l3M','Номинальный M',10,'Н·м')}${field('l3eps','εmax',.003,'м')}${field('l3beta','β',5,'—')}${field('l3amin','a min',.004,'м')}${field('l3amax','a max',.08,'м')}${field('l3astep','Шаг a',.001,'м')}${field('l3bmin','b min',.004,'м')}${field('l3bmax','b max',.12,'м')}${field('l3bstep','Шаг b',.001,'м')}</div><div class="actions"><button class="btn primary" onclick="calc3()">Подобрать сечение</button><button class="btn" onclick="setMaterial3()">Применить материал</button></div><details><summary>Основные зависимости</summary><div class="formula">C₃ˣˣ = EF/l; C₃ˣʸ = 2EJz/l; Jz = ab³/12</div><div class="formula">ε = √(δₓₓ² + l²(φ₃ˣʸ + φpˣʸ)²)</div><div class="formula">m = ρabl + (Kд + Kp)M → min</div></details>`;$('content').innerHTML=shell(inputs,'Параметры a и b — размеры прямоугольного сечения. Поиск выполняется по сетке с условием b ≤ βa.');$('l3mat').addEventListener('change',setMaterial3)}
function fillV3(){const i=parseInt($('l3variant').value)-1;if(i<0)return;const v=V3[i];['l3l','l3phi','l3fext','l3mext'].forEach((id,j)=>$(id).value=v[j])}
function setMaterial3(){const m=$('l3mat').value;if(m==='1'){$('l3E').value=2.1e11;$('l3rho').value=7800}else if(m==='2'){$('l3E').value=.75e11;$('l3rho').value=2700}}
function eval3(a,b,p){const F=a*b,Jz=a*b**3/12,Cxx=p.E*F/p.l,Cxy=2*p.E*Jz/p.l,Cp=p.sp*p.M,X=(p.Fext+p.rho*F*p.l*G)*Math.sin(p.phi),Y=(p.Fext+p.rho*F*p.l*G)*Math.cos(p.phi),Md=-p.Mext+(p.Fext+.5*p.rho*F*p.l*G)*p.l*Math.cos(p.phi),delta=X/Cxx,phib=Md/Cxy,phip=Md/Cp,eps=Math.hypot(delta,p.l*(phib+phip)),mass=p.rho*F*p.l+(p.kd+p.kp)*p.M;return{a,b,F,Jz,Cxx,Cxy,Cp,X,Y,Md,delta,phib,phip,eps,mass}}
function calc3(){const p={l:n('l3l'),phi:n('l3phi'),Fext:n('l3fext'),Mext:n('l3mext'),E:n('l3E'),rho:n('l3rho'),kd:n('l3kd'),kp:n('l3kp'),sp:n('l3sp'),M:n('l3M'),eps:n('l3eps'),beta:n('l3beta')},amin=n('l3amin'),amax=n('l3amax'),da=n('l3astep'),bmin=n('l3bmin'),bmax=n('l3bmax'),db=n('l3bstep');if(Object.values(p).some(v=>!Number.isFinite(v))||[amin,amax,da,bmin,bmax,db].some(v=>!Number.isFinite(v))||da<=0||db<=0)return resultCard('Ошибка ввода','Проверьте поля и шаги.','','Ошибка ввода');let best=null,ok=[];for(let a=amin;a<=amax+da/3;a+=da)for(let b=bmin;b<=bmax+db/3;b+=db){if(b>p.beta*a+1e-12)continue;const r=eval3(a,b,p);if(r.eps<=p.eps+1e-12){ok.push(r);if(!best||r.mass<best.mass)best=r}}if(!best)return resultCard('Допустимое сечение не найдено','Расширьте диапазоны a, b либо проверьте исходные данные.','<div class="note warning">Ни одна пара не выполнила ε ≤ εmax и b ≤ βa.</div>','Лабораторная 3: решение не найдено');ok.sort((a,b)=>a.mass-b.mass);const body=`<div class="metric-grid">${metric('Оптимальное a',fmt(best.a*1000,3),'мм')}${metric('Оптимальное b',fmt(best.b*1000,3),'мм')}${metric('Масса конструкции',fmt(best.mass,6),'кг','ok')}${metric('Погрешность ε',fmt(best.eps*1000,6),'мм')}</div><div class="table-wrap"><table><thead><tr><th>#</th><th>a, мм</th><th>b, мм</th><th>ε, мм</th><th>m, кг</th></tr></thead><tbody>${ok.slice(0,10).map((r,i)=>`<tr><td>${i+1}</td><td>${fmt(r.a*1000,3)}</td><td>${fmt(r.b*1000,3)}</td><td>${fmt(r.eps*1000,6)}</td><td>${fmt(r.mass,6)}</td></tr>`).join('')}</tbody></table></div><details open><summary>Промежуточные величины оптимума</summary><p>F=${sci(best.F)} м²; Jz=${sci(best.Jz)} м⁴; C₃ˣˣ=${sci(best.Cxx)} Н/м; C₃ˣʸ=${sci(best.Cxy)} Н·м/рад; Cpˣʸ=${sci(best.Cp)} Н·м/рад.</p><p>X=${fmt(best.X,6)} Н; Y=${fmt(best.Y,6)} Н; Mд=${fmt(best.Md,6)} Н·м; δₓₓ=${sci(best.delta)} м; φ балки=${sci(best.phib)} рад; φ передачи=${sci(best.phip)} рад.</p></details><canvas id="chart3" width="900" height="420"></canvas>`;const text=`Лабораторная №3 — синтез жёсткости\nОптимальное сечение: a=${best.a} м (${best.a*1000} мм), b=${best.b} м (${best.b*1000} мм)\nМасса m=${best.mass} кг; погрешность ε=${best.eps} м ≤ ${p.eps} м\nCxx=${best.Cxx}; Cxy=${best.Cxy}; Cp=${best.Cp}; Mд=${best.Md}`;resultCard('Минимальная масса найдена',`Допустимых вариантов: ${ok.length}.`,body,text);requestAnimationFrame(()=>drawScatter('chart3',ok,'a, м','b, м',r=>1/(r.mass+1e-9)))}

