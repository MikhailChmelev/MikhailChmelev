 ${variantSelect('l1variant',25,'fillV1()')}${selectField('l1rzPreset','Радиус рабочей зоны',[[.7891,'0,7891 м'],[.8473,'0,8473 м']])}
 ${field('l1x','X_A',-.701,'м')}${field('l1y','Y_A',.135,'м')}${field('l1c3','C₃',.09,'м')}${field('l1phiStep','Шаг ориентации Δφ',1,'град')}
